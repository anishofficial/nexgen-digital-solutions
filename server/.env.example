# ==============================================================================
# NexGen Studio — Backend Environment Variables Configuration Template
# NOTE: Copy this file to .env and configure strong values before deployment.
# NEVER commit real production secrets, passwords, or keys to source control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=https://YOUR_PRODUCTION_DOMAIN.example
CORS_ORIGINS=https://YOUR_PRODUCTION_DOMAIN.example,https://admin.YOUR_PRODUCTION_DOMAIN.example
TRUST_PROXY=true

# Database Configuration (Defaults to ./data/nexgen.db relative to server root)
DATABASE_PATH=./data/nexgen.db

# JWT Authentication Security (MUST be >= 32 characters in production)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d

# Admin Credentials (Auto-seeded on first run if user does not exist; password min 12 chars in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
ADMIN_NAME="NexGen Lead Architect"

# SMTP Transactional Email Service (Optional: leave empty to skip email dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
AGENCY_NOTIFICATION_EMAIL=leads@example.com
FROM_EMAIL="NexGen Studio <hello@example.com>"


